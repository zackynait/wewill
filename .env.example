# PostgreSQL
POSTGRES_DB=wewill
POSTGRES_USER=wewill_user
POSTGRES_PASSWORD=change_this_password
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Django
DJANGO_PORT=8000
DJANGO_SECRET_KEY=change_this_secret_key_to_something_very_secure
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_admin_password

# Daphne (ASGI Server)
DAPHNE_PORT=8002

# FastAPI
FASTAPI_PORT=8001
FASTAPI_SECRET_KEY=change_this_fastapi_secret_key
FASTAPI_DEBUG=True

# Next.js
NEXTJS_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8001
NEXT_PUBLIC_DAPHNE_URL=http://localhost:8002

# JWT Authentication
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# AI Services (OpenAI, Anthropic, etc.)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# OCR Services
TESSERACT_API_KEY=your_tesseract_api_key_here
GOOGLE_DOCUMENT_AI_API_KEY=your_google_document_ai_api_key_here

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
TWILIO_WHATSAPP_SANDBOX_NUMBER=your_twilio_sandbox_number
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Email Gateway (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
SMTP_USE_TLS=True

# File Upload
MAX_UPLOAD_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=pdf,csv,xlsx,xls

# Multi-tenant
TENANT_ISOLATION_STRATEGY=row_level_security

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
CELERY_LOG_LEVEL=INFO
